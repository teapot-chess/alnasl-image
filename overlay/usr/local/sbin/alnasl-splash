#!/bin/sh
# alnasl-splash: the boot screen painter. The program is AlnaslSetup.Splash in the setup-app release
# (/opt/alnasl-setup); this is its command line (--hold, --once, --set, --next, --value, --progress,
# --shutdown; see the module doc). The release takes about a second to start on a Pi, so every call
# costs that much; --hold is one long-running call and pays it once.
exec /opt/alnasl-setup/bin/alnasl_setup eval 'AlnaslSetup.CLI.main()' -- splash "$@"
