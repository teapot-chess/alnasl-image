#!/bin/bash
# The kiosk supervisor: Chromium full screen on HDMI, in a container.
#  - v5: the display path is X (KMS modesetting driver when the kernel has one, else fbdev) ALWAYS, unless
#    /etc/alnasl/kiosk.conf says KIOSK_PATH="cage". cage as root hangs instead of exiting once vc4 is up (seen on
#    the first real Pi: 45 s of black screen), so it is opt-in and kiosk.sh runs it behind a 10 s watchdog.
#  - no screen connected: sleeps (one log line, no spinning), starts the
#    moment one is plugged in
#  - the container exits or crashes: starts again, with a growing pause if it
#    keeps dying within 30 seconds (no log spam)
#  - v6: between two runs the boot screen is painted again (alnasl-splash), so
#    a restart shows the Alnasl picture, not the empty console X leaves behind
IMG=alnasl-kiosk:latest
NAME=alnasl-kiosk

screen_connected() {
  local s
  for s in /sys/class/drm/card*-*/status; do
    [ -r "$s" ] && [ "$(cat "$s")" = connected ] && return 0
  done
  return 1
}
have_fb() { [ -e /dev/fb0 ]; }

announced=""
fast=0
while true; do
  if ! docker image inspect "$IMG" >/dev/null 2>&1; then
    [ "$announced" != noimg ] && echo "kiosk: image $IMG not loaded yet; waiting" && announced=noimg && noimg_since=$(date +%s)
    # v7.1: alnasl-kiosk-load's job is dropped for good when docker was not up in time at boot (a "dependency"
    # failure is not a failure Restart= retries), and then nothing would ever load the image. Ask again, but only
    # when it is neither at work nor waiting for its next try (both are "activating").
    if [ $(( $(date +%s) - ${noimg_since:-0} )) -ge 60 ] &&
       ! systemctl show -p ActiveState --value alnasl-kiosk-load.service | grep -q -x -E 'active|activating|reloading'; then
      echo "kiosk: still no image after 60 s and nothing loading it; starting alnasl-kiosk-load again"
      systemctl start --no-block alnasl-kiosk-load.service
      noimg_since=$(date +%s)
    fi
    sleep 3; continue
  fi
  if screen_connected || have_fb; then   # no KMS output (vc4 did not load?) but a firmware framebuffer is enough for X
    :
  else
    [ "$announced" != noscreen ] && echo "kiosk: no screen connected; waiting for one" && announced=noscreen
    sleep 2; continue
  fi
  announced=""

  docker rm -f "$NAME" >/dev/null 2>&1
  # First boot is over once the screen starts: the browser's /boot page takes it from here.
  case "$(cat /run/alnasl-screen/state 2>/dev/null)" in firstboot-*) /usr/local/sbin/alnasl-splash --set clear ;; esac
  start=$(date +%s)
  # Keyboard layout and scale come from the settings pages (re-read at every start).
  KBD_LAYOUT=be KBD_VARIANT="" KIOSK_SCALE=100 KIOSK_RES=auto KIOSK_PATH=x
  [ -r /etc/alnasl/keyboard.conf ] && . /etc/alnasl/keyboard.conf
  [ -r /etc/alnasl/kiosk.conf ] && . /etc/alnasl/kiosk.conf
  # v7.3: a small screen on the pins (alnasl-screen.txt; alnasl-small-screen writes this at boot). An SPI panel names
  # its DRM card and fb (X drives that card, not HDMI); a 3.5-inch HDMI stylus screen fixes the mode and the
  # rotation. Anything but the expected words is dropped here and again in kiosk.sh.
  KIOSK_CARD="" KIOSK_FB="" KIOSK_FORCE_MODE="" KIOSK_ROTATE=normal
  [ -r /run/alnasl-small-screen/kiosk.env ] && . /run/alnasl-small-screen/kiosk.env
  case "$KIOSK_CARD" in card[0-9]|card[0-9][0-9]) ;; *) KIOSK_CARD="" ;; esac
  case "$KIOSK_FB" in /dev/fb[0-9]|/dev/fb[0-9][0-9]) ;; *) KIOSK_FB="" ;; esac
  case "$KIOSK_FORCE_MODE" in ""|[0-9]*x[0-9]*) ;; *) KIOSK_FORCE_MODE="" ;; esac
  case "$KIOSK_FORCE_MODE" in *[!0-9x]*) KIOSK_FORCE_MODE="" ;; esac
  case "$KIOSK_ROTATE" in normal|right|inverted|left) ;; *) KIOSK_ROTATE=normal ;; esac
  mkdir -p /run/alnasl-kiosk
  case "$KIOSK_PATH" in cage) mode=cage ;; *) mode=x ;; esac
  # v7: the page the screen shows is the role's own app; the watchdog inside watches that one.
  case "$(cat /run/alnasl-mode/role 2>/dev/null)" in
    arkab) app_port=4050 ;; polis) app_port=4061 ;; nunki) app_port=4062 ;; *) app_port=4040 ;;
  esac
  # v7.5: a nunki box's monitors (docs/nunki-displays.md): the layout its screen wizard saved on the data partition.
  # Read line by line, never sourced; anything but the expected words means the default.
  role=$(cat /run/alnasl-mode/role 2>/dev/null)
  KIOSK_LAYOUT=auto KIOSK_SWAP=0 KIOSK_ROT1=normal KIOSK_ROT2=normal
  if [ "$role" = nunki ] && [ -r /var/lib/alnasl-setup/displays.conf ]; then
    while IFS='=' read -r k v; do
      v=${v%$'\r'}; v=${v//\"/}
      case "$k=$v" in
        LAYOUT=auto|LAYOUT=single|LAYOUT=manage|LAYOUT=mirror|LAYOUT=two) KIOSK_LAYOUT=$v ;;
        SWAP=0|SWAP=1) KIOSK_SWAP=$v ;;
        ROTATE1=normal|ROTATE1=right|ROTATE1=inverted|ROTATE1=left) KIOSK_ROT1=$v ;;
        ROTATE2=normal|ROTATE2=right|ROTATE2=inverted|ROTATE2=left) KIOSK_ROT2=$v ;;
      esac
    done < /var/lib/alnasl-setup/displays.conf
  fi
  [ "$role" = nunki ] && echo "kiosk: nunki screens: layout $KIOSK_LAYOUT, swap $KIOSK_SWAP, rotation $KIOSK_ROT1/$KIOSK_ROT2"
  echo "kiosk: starting container (mode $mode, keyboard $KBD_LAYOUT/$KBD_VARIANT, scale $KIOSK_SCALE, resolution $KIOSK_RES${KIOSK_CARD:+, small screen on $KIOSK_CARD}${KIOSK_FORCE_MODE:+, small screen $KIOSK_FORCE_MODE}, rotation $KIOSK_ROTATE)"
  docker run --rm --name "$NAME" --privileged --network host --ipc host \
    -v /dev:/dev -v /run/udev:/run/udev:ro -v /run/alnasl-kiosk:/run/alnasl-kiosk \
    --tmpfs /tmp:exec,size=256m --shm-size=256m \
    -e KIOSK_MODE="$mode" -e KIOSK_URL=http://localhost:4041/boot -e KIOSK_APP_PORT="$app_port" \
    -e KBD_LAYOUT="$KBD_LAYOUT" -e KBD_VARIANT="$KBD_VARIANT" -e KIOSK_SCALE="$KIOSK_SCALE" -e KIOSK_RES="$KIOSK_RES" \
    -e KIOSK_CARD="$KIOSK_CARD" -e KIOSK_FB="$KIOSK_FB" -e KIOSK_FORCE_MODE="$KIOSK_FORCE_MODE" -e KIOSK_ROTATE="$KIOSK_ROTATE" \
    -e KIOSK_ROLE="$role" -e KIOSK_LAYOUT="$KIOSK_LAYOUT" -e KIOSK_SWAP="$KIOSK_SWAP" -e KIOSK_ROT1="$KIOSK_ROT1" -e KIOSK_ROT2="$KIOSK_ROT2" \
    "$IMG"
  rc=$?
  /usr/local/sbin/alnasl-splash --once
  took=$(( $(date +%s) - start ))
  if [ "$took" -lt 30 ]; then
    fast=$((fast + 1))
    pause=$(( fast * 10 )); [ "$pause" -gt 120 ] && pause=120
  else
    fast=0; pause=3
  fi
  echo "kiosk: container ended (exit $rc after ${took}s); next start in ${pause}s"
  sleep "$pause"
done
