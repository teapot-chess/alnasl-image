#!/bin/bash
# alnasl-mode: what this box is (v7, docs/v7-plan.md section 1). One box, one job:
#
#   alnasl   Alnasl, the hall's server, and the hall screen.        <- the default ("master" in v6)
#   arkab    Arkab: reads the DGT boards, passes them to an Alnasl.  ("slave" in v6)
#   polis    Polis: prints what the arbiter publishes (CUPS).
#   nunki    Nunki: reads the pairings aloud (espeak-ng, ALSA).
#
# Four words and a default; that is all the logic there is. /var/lib/alnasl-setup/mode holds the word (it
# lives on the data partition, so it survives system updates and is gone after a factory reset: back to the
# wizard, back to alnasl). v6 wrote "master" and "slave": they still mean alnasl and arkab, in that file and
# in mode-applied, so a box that upgrades stays what it was and does not switch anything back on.
# The wizard, Settings > "Change what this box is" and Arkab's page write it; /boot/efi/alnasl-mode.txt can
# too, for a box with no screen (first line one of the six words, read at boot and deleted).
#
# Runs at every boot, early (alnasl-mode.service), before any of the units below:
#   - writes /run/alnasl-mode/{mode,role,<role>}. Every role's units carry a ConditionPathExists on their
#     flag (drop-ins in /etc/systemd/system/<unit>.d/alnasl-mode.conf), so another role's unit cannot start,
#     whoever asks. Not masks: a mask replaces the unit file, and the apps' updaters write those files.
#     "mode" keeps the v6 word for the two v6 roles (master, slave); "role" is always the v7 word.
#   - disables what is still enabled of the other roles, every boot (a new slot comes with all of it on).
#   - on a change of role, the first boot after a reset, and the first boot of a new system slot (an update,
#     v6 -> v7 included) enables this role's units and the screen. What was applied is noted IN THE SLOT
#     (/etc/alnasl/role-applied), because that is where the enabled units are: a new slot comes with the
#     image's defaults (Alnasl on, the rest off), whatever the box was. v6 kept the note on the data
#     partition, so a v6 slave that updated came up with Arkab switched off; v7 does not.
#   - never touches any role's data: switching back loses nothing.
#
#   alnasl-mode            at boot
#   alnasl-mode --status   prints the role this boot runs as
set -u
STATE=/var/lib/alnasl-setup
MODEFILE=$STATE/mode
APPLIED=/etc/alnasl/role-applied
APPLIED_V6=$STATE/mode-applied   # v6's note, on the data partition: removed, it misleads
TXT=/boot/efi/alnasl-mode.txt
RUN=/run/alnasl-mode
ROLES="alnasl arkab polis nunki"

units() {
  case "$1" in
    alnasl) echo "alnasl.service alnasl-update.path" ;;
    arkab)  echo "arkab.service arkab-update.path" ;;
    polis)  echo "cups.socket cups.path cups.service polis.service polis-update.path" ;;
    nunki)  echo "alnasl-sound.service nunki.service nunki-update.path" ;;
  esac
}
# The v6 words and the v7 ones; anything else is not a role.
canon() {
  case "$1" in
    master|alnasl) echo alnasl ;;
    slave|arkab) echo arkab ;;
    polis|nunki) echo "$1" ;;
  esac
}
legacy() { case "$1" in alnasl) echo master ;; arkab) echo slave ;; *) echo "$1" ;; esac; }

say() { echo "alnasl-mode: $*"; }

if [ "${1:-}" = "--status" ]; then
  cat "$RUN/role" 2>/dev/null || echo unknown
  exit 0
fi

mkdir -p "$STATE" "$RUN"

# 1. the boot-partition file, for a box with no screen to run the wizard on
if [ -f "$TXT" ]; then
  word=$(head -n 1 "$TXT" | tr -d '\r[:space:]' | tr '[:upper:]' '[:lower:]')
  rm -f "$TXT"; sync
  r=$(canon "$word")
  if [ -n "$r" ]; then
    echo "$r" > "$MODEFILE.new" && mv -f "$MODEFILE.new" "$MODEFILE"
    say "set to $r by $TXT"
  else
    say "$TXT did not say alnasl, arkab, polis or nunki on its first line; removed it, changed nothing"
  fi
fi

# 2. the role: what the file says, alnasl when it says nothing (or nonsense)
role=$(canon "$({ tr -d '[:space:]' < "$MODEFILE"; } 2>/dev/null)")  # no file is the normal case
[ -n "$role" ] || role=alnasl
applied=$(canon "$({ tr -d '[:space:]' < "$APPLIED"; } 2>/dev/null)")
want=$(units "$role")
other=""
for r in $ROLES; do [ "$r" = "$role" ] || other="$other $(units "$r")"; done

for r in $ROLES master slave; do rm -f "$RUN/$r"; done
legacy "$role" > "$RUN/mode"
echo "$role" > "$RUN/role"
touch "$RUN/$role"
say "this boot runs as $role"

# 3. the units. The other roles are switched off every boot; only what is still enabled is touched (enable
# and disable make systemd reload, and a boot where nothing changed needs none of that).
for u in $other; do systemctl is-enabled -q "$u" 2>/dev/null && systemctl disable "$u" >/dev/null 2>&1; done
# This role's units are switched on only when the role changed, so what somebody switched off in Settings >
# Services (the screen, say) stays off on a box that is still what it was.
if [ "$applied" != "$role" ]; then
  say "applying $role"
  # shellcheck disable=SC2086
  systemctl enable $want alnasl-kiosk.service >/dev/null 2>&1
  echo "$role" > "$APPLIED.new" && mv -f "$APPLIED.new" "$APPLIED"
fi
rm -f "$APPLIED_V6"
# What runs of another role stops (a live switch; at boot nothing runs yet). What is enabled of this role
# starts now: this boot's job list was made before this unit decided anything.
for u in $other; do systemctl is-active -q "$u" 2>/dev/null && systemctl stop --no-block "$u"; done
for u in $want; do systemctl is-enabled -q "$u" 2>/dev/null && systemctl start --no-block "$u"; done
exit 0
