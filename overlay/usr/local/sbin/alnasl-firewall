#!/bin/bash
# Alnasl hall box firewall. Fail-open-safe by construction:
#
#  1. The built-in INPUT policy is NEVER changed from ACCEPT. The "default
#     deny" is the last rule of our own chain (ALNASL-IN), reached only after
#     the rules that let the box's own app (and loopback) in. So a ruleset that fails to load,
#     loads halfway, or is flushed leaves the box OPEN, never closed with the
#     hall locked out. (v6: open costs little; there is no ssh to reach.)
#  2. The chain is loaded in one atomic iptables-restore, after a --test
#     dry run. Our chain is only hooked into INPUT once it is complete.
#  3. Afterwards the script checks that the app's rule (or, for a role with no
#     inbound port, the loopback rule) is really in place; if not, it unhooks
#     the chain again.
#  4. Only our own chain is touched. Anyone else's chains (docker's) are
#     left alone, and the stock iptables.service (INPUT policy DROP, loaded
#     from /etc/systemd/scripts/ip4save) is disabled in this image.
#
# v7: inbound is only what the box's role needs (docs/v7-plan.md section 1):
#   alnasl  4040 (Alnasl, for the hall's network)
#   arkab   4050 (Arkab's status page)
#   polis, nunki  no port at all: they dial out, and their pages are for this box's own screen
# plus mDNS, DHCP replies and ICMP. Nothing else: no ssh (22), nothing for Tailscale on the LAN (41641 stays shut).
# v7.5, remote access (opt-in, docs/remote-access.md): only while alnasl-tailscale.service runs
# (/run/alnasl-tailscale/active, which its ExecStartPre writes and its ExecStopPost removes, each followed by a
# reload of this), the role's own page is let in on tailscale0 and nowhere else: 4040, 4050, 4061 (polis), 4062
# (nunki; Polis and Nunki then listen beyond loopback, their PIN still asks). Tailscale SSH never reaches these
# rules: tailscaled answers it itself on the tailnet address. With remote access off this prints nothing and the
# rules are exactly the ones above.
# The setup hotspot (docs/captive-portal.md), while it is up (/run/alnasl-hotspot/active, which
# alnasl-hotspot writes before it reloads this): DNS (53), DHCP (67) and the setup page (80), on wlan0
# and on the hotspot's address only, never on Ethernet; and the hotspot's phones get nothing else, not
# even the role's port. alnasl-hotspot reloads this when the hotspot goes, and the rules go with it.
# verify.sh fails the build if either comes back. The role is /run/alnasl-mode/role (alnasl-mode runs
# first); no role file means alnasl, as everywhere.
#
# Usage: alnasl-firewall [start|stop|status]   (start is the default)

CHAIN=ALNASL-IN
log() { echo "alnasl-firewall: $*"; }
ROLE=$(cat /run/alnasl-mode/role 2>/dev/null)
case "$ROLE" in
  arkab) PORT=4050 ;;
  polis | nunki) PORT="" ;;
  *) ROLE=alnasl; PORT=4040 ;;
esac
HS_FLAG=/run/alnasl-hotspot/active
HS_IF=wlan0
HS_ADDR=10.42.0.1
HS_NET=10.42.0.0/24
hotspot_v4() {
  [ -e "$HS_FLAG" ] || return 0
  echo "-A $CHAIN -i $HS_IF -d $HS_ADDR/32 -p udp --dport 53 -j ACCEPT"
  echo "-A $CHAIN -i $HS_IF -d $HS_ADDR/32 -p tcp --dport 53 -j ACCEPT"
  echo "-A $CHAIN -i $HS_IF -p udp --sport 68 --dport 67 -j ACCEPT"
  echo "-A $CHAIN -i $HS_IF -d $HS_ADDR/32 -p tcp --dport 80 -j ACCEPT"
  echo "-A $CHAIN -i $HS_IF -s $HS_NET -p icmp -j ACCEPT"
  # A phone that tries https first (Safari does) should hear "no" at once and fall back to http,
  # not wait on a dropped packet with a grey sheet in front of its owner.
  echo "-A $CHAIN -i $HS_IF -d $HS_ADDR/32 -p tcp --dport 443 -j REJECT --reject-with tcp-reset"
  echo "-A $CHAIN -i $HS_IF -d $HS_ADDR/32 -p udp --dport 443 -j REJECT --reject-with icmp-port-unreachable"
  echo "-A $CHAIN -i $HS_IF -j DROP"
}
hotspot_v6() { [ -e "$HS_FLAG" ] && echo "-A $CHAIN -i $HS_IF -j DROP"; return 0; }
# DEBUG SSH IMAGES ONLY (build.ps1 -DebugSsh, docs/debug-ssh.md): the build drops this flag into the image and
# sshd then gets port 22 on Ethernet and Wi-Fi. It comes after the hotspot's wlan0 DROP, so a phone on the setup
# hotspot still gets nothing. A normal image has no flag and no sshd, and this prints nothing.
DBG_SSH_FLAG=/etc/alnasl/debug-ssh
ssh_rule() { [ -e "$DBG_SSH_FLAG" ] && echo "-A $CHAIN -p tcp --dport 22 -j ACCEPT"; return 0; }
app_rule() { [ -n "$PORT" ] && echo "-A $CHAIN -p tcp --dport $PORT -j ACCEPT"; }
TS_FLAG=/run/alnasl-tailscale/active
case "$ROLE" in arkab) TS_PORT=4050 ;; polis) TS_PORT=4061 ;; nunki) TS_PORT=4062 ;; *) TS_PORT=4040 ;; esac
tailnet_rule() { [ -e "$TS_FLAG" ] && echo "-A $CHAIN -i tailscale0 -p tcp --dport $TS_PORT -j ACCEPT"; return 0; }

unhook() { # tool
  local t=$1
  while "$t" -D INPUT -j "$CHAIN" 2>/dev/null; do :; done
  "$t" -F "$CHAIN" 2>/dev/null
  "$t" -X "$CHAIN" 2>/dev/null
  return 0
}

open_everything() { # tool: last resort
  local t=$1
  unhook "$t"
  "$t" -P INPUT ACCEPT 2>/dev/null
  return 0
}

rules_v4() {
  sed '/^$/d' <<EOF
*filter
:$CHAIN - [0:0]
-A $CHAIN -i lo -j ACCEPT
-A $CHAIN -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
$(hotspot_v4)
$(app_rule)
$(tailnet_rule)
$(ssh_rule)
-A $CHAIN -p icmp -j ACCEPT
-A $CHAIN -p udp --sport 67 --dport 68 -j ACCEPT
-A $CHAIN -p udp --dport 5353 -j ACCEPT
-A $CHAIN -j DROP
COMMIT
EOF
}

rules_v6() {
  sed '/^$/d' <<EOF
*filter
:$CHAIN - [0:0]
-A $CHAIN -i lo -j ACCEPT
-A $CHAIN -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
$(hotspot_v6)
$(app_rule)
$(tailnet_rule)
$(ssh_rule)
-A $CHAIN -p ipv6-icmp -j ACCEPT
-A $CHAIN -p udp --dport 546 -j ACCEPT
-A $CHAIN -p udp --dport 5353 -j ACCEPT
-A $CHAIN -j DROP
COMMIT
EOF
}

apply() { # tool rules-function
  local t=$1 fn=$2 rc=0
  command -v "$t" >/dev/null 2>&1 || { log "$t not installed; skipping"; return 0; }
  # A clean slate for our chain only, and the policy back to ACCEPT in case an
  # older ruleset (the stock one) set it to DROP.
  unhook "$t"
  "$t" -P INPUT ACCEPT 2>/dev/null

  if ! "$fn" | "${t}-restore" --noflush --test 2>/dev/null; then
    log "$t: the ruleset did not pass the dry run; leaving the box open"
    return 1
  fi
  if ! "$fn" | "${t}-restore" --noflush 2>/dev/null; then
    log "$t: loading the ruleset failed; leaving the box open"
    open_everything "$t"
    return 1
  fi
  if [ -n "$PORT" ] && ! "$t" -C "$CHAIN" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null ||
     ! "$t" -C "$CHAIN" -i lo -j ACCEPT 2>/dev/null; then
    log "$t: the rule for $ROLE (or loopback) is not in the chain; leaving the box open"
    open_everything "$t"
    return 1
  fi
  # Only now is the chain made to count.
  if ! "$t" -I INPUT 1 -j "$CHAIN" 2>/dev/null; then
    log "$t: could not hook the chain; leaving the box open"
    open_everything "$t"
    return 1
  fi
  log "$t: ruleset active for $ROLE (${PORT:-no app port}, DHCP, mDNS, ICMP$([ -e "$HS_FLAG" ] && echo "; setup hotspot on $HS_IF: DNS, DHCP, page")$([ -e "$DBG_SSH_FLAG" ] && echo "; DEBUG IMAGE: ssh on 22")$([ -e "$TS_FLAG" ] && echo "; remote access on: $TS_PORT on tailscale0"); everything else dropped)"
  return 0
}

case "${1:-start}" in
  start | reload)
    apply iptables rules_v4
    apply ip6tables rules_v6
    # Whatever happened, this service itself never fails the boot.
    exit 0
    ;;
  stop)
    open_everything iptables
    open_everything ip6tables
    log "stopped; box is open"
    exit 0
    ;;
  status)
    iptables -S "$CHAIN" 2>&1
    iptables -S INPUT 2>&1 | head -3
    ;;
  *)
    echo "usage: $0 [start|stop|status]" >&2
    exit 2
    ;;
esac
