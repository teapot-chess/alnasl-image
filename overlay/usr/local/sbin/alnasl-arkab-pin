#!/bin/bash
# Reads /boot/efi/alnasl-arkab-pin.txt (the FAT partition, writable from any PC), and when its PIN= line is
# filled in on a box whose role is Arkab, hands that PIN to Arkab, then blanks the line again and writes
# what became of it on the file's last line, so a mistake shows when the card goes back into a PC.
#
#   PIN=4821          set (or change) the remote PIN; 4 to 64 characters, no space or quote at either end
#   PIN=remove        remove it (PIN=verwijderen too)
#   PIN=              nothing; the file is left exactly as it is
#
# The hand-over is a request file, /var/lib/arkab/pin-request (0600, owner arkab), that Arkab reads when it
# starts and deletes (Arkab.PinRequest); arkab.service is ordered after this unit. Nothing listens for it and
# the web page still cannot set a PIN. The PIN is never printed, logged or put on a command line.
#
# For the checks, three paths can be pointed elsewhere: ALNASL_ARKAB_PIN_FILE, ALNASL_ARKAB_DATA,
# ALNASL_MODE_FLAG; and ALNASL_ARKAB_OWNER (empty = no chown).
FILE=${ALNASL_ARKAB_PIN_FILE:-/boot/efi/alnasl-arkab-pin.txt}
DATA=${ALNASL_ARKAB_DATA:-/var/lib/arkab}
FLAG=${ALNASL_MODE_FLAG:-/run/alnasl-mode/arkab}
OWNER=${ALNASL_ARKAB_OWNER-arkab:arkab}

[ -f "$FILE" ] || exit 0
# Only an Arkab box reads it; on any other role the file is left alone.
[ -e "$FLAG" ] || exit 0

pin=""; found=0
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%$'\r'}
  case "$line" in
    PIN=*) if [ "$found" = 0 ]; then pin=${line#PIN=}; found=1; fi ;;
  esac
done < "$FILE"

# Empty PIN line: nothing asked, nothing touched.
[ -n "$pin" ] || exit 0

# Rewrites the file with the PIN line blank and $1 as the last line. Written whole, then moved over.
rewrite() {
  local tmp="$FILE.new" line
  {
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      case "$line" in
        PIN=*) printf 'PIN=\r\n' ;;
        '# Last result:'*) ;;
        *) printf '%s\r\n' "$line" ;;
      esac
    done < "$FILE"
    printf '# Last result: %s\r\n' "$1"
  } > "$tmp" && mv -f "$tmp" "$FILE"
  sync
}

refuse() {
  rewrite "refused, $1 ($(date '+%Y-%m-%d %H:%M'), the box's own clock)"
  echo "alnasl-arkab-pin: the PIN was refused, $1; the PIN line is blank again"
  exit 0
}

# Not handed over: the PIN stays in the file so the next boot tries again, and the last line says so.
fail() {
  local tmp="$FILE.new" line
  {
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      case "$line" in
        '# Last result:'*) ;;
        *) printf '%s\r\n' "$line" ;;
      esac
    done < "$FILE"
    printf '# Last result: not handed to Arkab, %s; the PIN is still here and is tried again at the next boot\r\n' "$1"
  } > "$tmp" && mv -f "$tmp" "$FILE"
  sync
  echo "alnasl-arkab-pin: could not hand the PIN to Arkab, $1; tried again at the next boot"
  exit 0
}

lower=${pin,,}
if [ "$lower" = remove ] || [ "$lower" = verwijderen ]; then
  action=remove
else
  action=set
  # Bytes, not characters: plain keyboard characters are one byte each, and the header says to keep to them.
  [ "${#pin}" -ge 4 ] || refuse "too short (needs 4 to 64 characters)"
  [ "${#pin}" -le 64 ] || refuse "too long (needs 4 to 64 characters)"
  case "$pin" in
    ' '*|*' ') refuse "a space at the start or the end" ;;
    '"'*|*'"'|"'"*|*"'") refuse "a quote at the start or the end" ;;
    *[[:cntrl:]]*) refuse "a control character in it" ;;
  esac
fi

[ -d "$DATA" ] || fail "its data folder is missing"
umask 077
req="$DATA/pin-request"
if [ "$action" = remove ]; then
  printf 'remove\n' > "$req.new" || fail "could not write the request"
else
  printf 'set\n%s\n' "$pin" > "$req.new" || fail "could not write the request"
fi
if [ -n "$OWNER" ]; then
  chown "$OWNER" "$req.new" || { rm -f "$req.new"; fail "could not give the request to Arkab's account"; }
fi
chmod 600 "$req.new"
mv -f "$req.new" "$req" || { rm -f "$req.new"; fail "could not place the request"; }

when=$(date '+%Y-%m-%d %H:%M')
if [ "$action" = remove ]; then
  rewrite "PIN removal handed to Arkab on $when (the box's own clock)"
  echo "alnasl-arkab-pin: PIN removal handed to Arkab"
else
  rewrite "PIN set on $when (the box's own clock); Arkab applies it as it starts"
  echo "alnasl-arkab-pin: a PIN was handed to Arkab"
fi
exit 0
